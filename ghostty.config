font-family = JetBrainsMono Nerd Font
font-size = 14
background = #181818
foreground = #D4D4D4
cursor-color = #AEAFAD
cursor-text = #181818
selection-background = #264F78
selection-foreground = #FFFFFF

# ANSI palette
palette = 0=#1E1E1E
palette = 1=#F48771
palette = 2=#89D185
palette = 3=#DCDCAA
palette = 4=#569CD6
palette = 5=#C586C0
palette = 6=#4EC9B0
palette = 7=#D4D4D4
palette = 8=#808080
palette = 9=#F48771
palette = 10=#89D185
palette = 11=#DCDCAA
palette = 12=#569CD6
palette = 13=#C586C0
palette = 14=#4EC9B0
palette = 15=#FFFFFF
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.9
background-blur = 20
unfocused-split-opacity = 0.8
macos-option-as-alt = true
copy-on-select = clipboard
shell-integration-features = cursor,sudo,title
