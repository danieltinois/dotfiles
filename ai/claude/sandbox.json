{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "docker *",
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm/_cacache"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.codex/auth.json",
        "~/.config/gh/hosts.yml",
        "~/.docker",
        "~/.kube",
        "~/.azure",
        "~/.config/gcloud",
        "~/.npmrc",
        "~/.netrc",
        "~/.git-credentials",
        "~/.gradle/gradle.properties",
        "~/.pub-cache/credentials.json",
        "~/Library/Application Support/dart/pub-credentials.json"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "dev.azure.com",
        "*.dev.azure.com",
        "*.visualstudio.com"
      ],
      "allowLocalBinding": true
    }
  }
}
